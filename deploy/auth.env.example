AUTH_ADDR=:8081
APP_ENV=production
GATEWAY_SHARED_TOKEN=

SESSION_BACKEND=redis
SESSION_COOKIE_NAME=__Secure-sg_session
SESSION_COOKIE_DOMAIN=.shiguanglab.com
SESSION_ENCRYPTION_KEY=
SESSION_IDLE_TTL=12h
SESSION_ABSOLUTE_TTL=168h
REDIS_PASSWORD=
REDIS_URL=redis://:password@redis:6379/0
REDIS_KEY_PREFIX=auth:session:

PUBLIC_ORIGIN=https://shiguanglab.com
ZITADEL_ISSUER=https://sso.shiguanglab.com
ZITADEL_INTERNAL_URL=http://zitadel-api:8080
ZITADEL_PAT_FILE=/run/secrets/zitadel-login-client.pat
ZITADEL_REGISTRATION_PAT_FILE=/run/secrets/zitadel-registration-client.pat
ZITADEL_ORGANIZATION_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://shiguanglab.com/api/auth/oidc/callback
ALLOWED_RETURN_ORIGINS=https://shiguanglab.com,https://www.shiguanglab.com,https://opc.shiguanglab.com,https://huiguang.shiguanglab.com,https://points.shiguanglab.com
# Exact browser origins allowed to use the high-risk Points IAM role API.
IAM_ROLE_ADMIN_ORIGINS=https://points.shiguanglab.com
# Encrypted operational command journal. This is recovery state, not permanent
# compliance audit storage.
IAM_ROLE_COMMAND_PREFIX=auth:iam-role-command:
IAM_ROLE_COMMAND_TTL=720h
DEFAULT_ENTITLEMENTS=superagents:access,huiguang:access,platform:access

IDENTITY_ISSUER=https://shiguanglab.com
IDENTITY_SIGNING_KEY_FILE=/run/secrets/identity-signing.pem
IDENTITY_KEY_ID=sg-auth-2026-01
IDENTITY_TOKEN_TTL=1m

# Optional server-to-server login for localhost product development. The
# returned opaque broker is audience-fixed and must never enter browser code.
LOCAL_BROKER_ENABLED=false
LOCAL_BROKER_PRODUCT_ID=asset-hub
LOCAL_BROKER_AUDIENCE=asset-hub-api
LOCAL_BROKER_REQUIRED_ENTITLEMENTS=asset-hub:access
LOCAL_BROKER_TTL=12h

# Platform project that carries org:* roles (business organizations)
ZITADEL_PROJECT_ID=
# Service credential for the product identity facade (/v1/identity/*)
IDENTITY_API_TOKEN=
# Dedicated server-side credential for Points user search; never expose to browsers.
POINTS_IDENTITY_SERVICE_TOKEN=
