AUTH_ADDR=:8081
APP_ENV=production
GATEWAY_SHARED_TOKEN=

SESSION_BACKEND=redis
SESSION_COOKIE_NAME=__Secure-sg_session
SESSION_COOKIE_DOMAIN=.shiguanglab.com
SESSION_ENCRYPTION_KEY=
SESSION_IDLE_TTL=12h
SESSION_ABSOLUTE_TTL=168h
REDIS_PASSWORD=
REDIS_URL=redis://:password@redis:6379/0
REDIS_KEY_PREFIX=auth:session:

PUBLIC_ORIGIN=https://shiguanglab.com
ZITADEL_ISSUER=https://sso.shiguanglab.com
ZITADEL_INTERNAL_URL=http://zitadel-api:8080
ZITADEL_PAT_FILE=/run/secrets/zitadel-login-client.pat
ZITADEL_REGISTRATION_PAT_FILE=/run/secrets/zitadel-registration-client.pat
ZITADEL_ORGANIZATION_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://shiguanglab.com/api/auth/oidc/callback
ALLOWED_RETURN_ORIGINS=https://shiguanglab.com,https://www.shiguanglab.com,https://opc.shiguanglab.com,https://huiguang.shiguanglab.com,https://point.shiguanglab.com,https://skills.shiguanglab.com
# Exact browser origins allowed to use the high-risk product role APIs.
IAM_ROLE_ADMIN_ORIGINS=https://shiguanglab.com,https://point.shiguanglab.com
# Encrypted operational command journal. This is recovery state, not permanent
# compliance audit storage.
IAM_ROLE_COMMAND_PREFIX=auth:iam-role-command:
IAM_ROLE_COMMAND_TTL=720h
DEFAULT_ENTITLEMENTS=superagents:access,huiguang:access,platform:access,asset-hub:access

IDENTITY_ISSUER=https://shiguanglab.com
IDENTITY_SIGNING_KEY_FILE=/run/secrets/identity-signing.pem
IDENTITY_KEY_ID=sg-auth-2026-01
IDENTITY_TOKEN_TTL=1m

# Optional server-to-server login for localhost product development. The
# returned opaque broker is audience-fixed and must never enter browser code.
LOCAL_BROKER_ENABLED=false
# Preferred multi-product allowlist. The client chooses only productId; the
# server owns audience and entitlement policy and binds the broker to it.
LOCAL_BROKER_POLICIES=[{"productId":"asset-hub","audience":"asset-hub-api","requiredEntitlements":["asset-hub:access"]},{"productId":"opc","audience":"superagents-bff","requiredEntitlements":["superagents:access"]}]
# Legacy single-product form, used only when LOCAL_BROKER_POLICIES is empty.
LOCAL_BROKER_PRODUCT_ID=asset-hub
LOCAL_BROKER_AUDIENCE=asset-hub-api
LOCAL_BROKER_REQUIRED_ENTITLEMENTS=asset-hub:access
LOCAL_BROKER_TTL=12h

# Platform project that carries org:* roles (business organizations)
ZITADEL_PROJECT_ID=
# Service credential for the product identity facade (/v1/identity/*)
IDENTITY_API_TOKEN=
# Dedicated server-side credential for Points user search; never expose to browsers.
POINTS_IDENTITY_SERVICE_TOKEN=

# OAuth 2.0 authorization server for first-party native clients (Obsidian).
# Off by default: the endpoints stay unmounted until this is switched on.
OAUTH_ENABLED=false
# Must be an absolute https URL. Defaults to PUBLIC_ORIGIN.
OAUTH_ISSUER=https://shiguanglab.com
# Where an unauthenticated authorize request is sent, with return_to attached.
OAUTH_LOGIN_URL=https://shiguanglab.com/login
OAUTH_CLIENT_ID=obsidian-asset-hub
OAUTH_CLIENT_NAME=知序资产中心 for Obsidian
# Templates, not literals. The port is omitted on purpose: a native client binds
# an ephemeral port it cannot know in advance (RFC 8252 §7.3).
OAUTH_CLIENT_REDIRECT_URIS=http://127.0.0.1/callback,http://[::1]/callback
OAUTH_CLIENT_SCOPES=documents:read,documents:write,offline_access
OAUTH_CLIENT_AUDIENCE=asset-hub-api
OAUTH_ACCESS_TOKEN_TTL=15m
OAUTH_REFRESH_TOKEN_TTL=720h
OAUTH_CODE_TTL=1m
OAUTH_CONSENT_TTL=10m
OAUTH_REQUIRED_ENTITLEMENTS=asset-hub:access
OAUTH_REDIS_KEY_PREFIX=auth:oauth:
# Image version published by the tag-triggered GitHub Actions workflow.
AUTH_SERVICE_IMAGE_TAG=latest
